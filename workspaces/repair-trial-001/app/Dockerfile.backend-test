FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN python -m pip install --no-cache-dir \
    "Flask>=3,<4" \
    "pytest>=8,<9"

COPY app.py /app/app.py
COPY templates/ /app/templates/
COPY static/ /app/static/
COPY tests/test_backend.py /app/tests/test_backend.py

USER 10001:10001

CMD ["python", "-m", "pytest", "tests/test_backend.py", "-v", "-p", "no:cacheprovider"]
