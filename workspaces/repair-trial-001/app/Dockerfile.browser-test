FROM mcr.microsoft.com/playwright/python:v1.64.1-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    HOME=/tmp

WORKDIR /app

RUN python -m pip install --no-cache-dir \
    "Flask>=3,<4" \
    "pytest>=8,<9" \
    "playwright==1.64.1" \
    pytest-playwright

COPY app.py /app/app.py
COPY templates/ /app/templates/
COPY static/ /app/static/
COPY tests/test_backend.py /app/tests/test_backend.py
COPY tests/test_browser.py /app/tests/test_browser.py

USER 10001:10001

CMD ["python", "-m", "pytest", "tests", "-v", "--tb=short", "-p", "no:cacheprovider", "--output=/tmp/test-results"]
